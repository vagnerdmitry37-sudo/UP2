{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Options": {
    "Database": {
      "ConnectionString": "Host=localhost;Port=5432;Database=up;Username=up",
      "MaxRetryCount": 3,
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": false
    },
    "Jwt": {
      "Issuer": "up-api",
      "Audience": "up-client",
      "AccessTokenLifetimeMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 14
    }
  }
}
